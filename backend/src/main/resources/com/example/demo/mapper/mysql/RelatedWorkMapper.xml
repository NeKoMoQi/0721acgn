<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.mysql.RelatedWorkMapper">
    <select id="listBySource" resultType="com.example.demo.com.RelatedLink">
        SELECT dst_type AS dstType, dst_id AS dstId
        FROM 0721acgn.tb_related_work
        WHERE src_type = #{srcType}
          AND src_id = #{srcId}
    </select>
</mapper>
