<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.mysql.NovelChaptersMapper">
    <select id="getNovelChapters" resultType="com.example.demo.com.NovelChapter">
        select title,chapterid,chapterno,novelurl from 0721acgn.tb_novelchapter where novelid = #{id} order by chapterno ASC
    </select>
</mapper>