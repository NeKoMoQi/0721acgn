<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.mysql.ActivityMapper">
    <select id="getActivityById">
        select * from 0721acgn.tb_activity LIMIT #{a},9
    </select>
    <select id="getallActivity" resultType="com.example.demo.com.Activity">
        select * from 0721acgn.tb_activity LIMIT 9
    </select>
    <select id="gethotActivity" resultType="com.example.demo.com.Activity">
        select id,activityname,click from 0721acgn.tb_activity order by click desc LIMIT 9;
    </select>
    <select id="getLiebieActivity" resultType="com.example.demo.com.LeiBie">
        select id,Actleibie,count from 0721acgn.tb_leibie;
    </select>
</mapper>