<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.mysql.CartoonChaptersMapper">
    <select id="getAllCartoonChapters" resultType="com.example.demo.com.Cartoonchapters">
        select title,chapterid,chapterno from 0721acgn.tb_cartoonchapters where comicid = #{id} order by chapterno ASC
    </select>
</mapper>