[
  {
    "type": "function",
    "function": {
      "name": "search_spots",
      "description": "检索站内真实巡礼点。短关键词为或匹配，city额外过滤。全部为空返回作品目录。每页32点，最多128个候选。",
      "parameters": {
        "type": "object",
        "properties": {
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 8
          },
          "city": {
            "type": "string",
            "description": "城市短名，例如京都；不限则空字符串"
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 500
          }
        },
        "required": [
          "keywords",
          "city",
          "offset"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "search_knowledge",
      "description": "查询站内规划、拍摄礼仪、交通边界与多作品主题参考，返回来源和更新时间；不提供实时营业与班次。",
      "parameters": {
        "type": "object",
        "properties": {
          "keywords": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "keywords"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "submit_route",
      "description": "提交完整新版按天行程，只用已检索或上一版已验证的点ID。服务器校验补齐坐标和图片，失败按错误修正。",
      "parameters": {
        "type": "object",
        "properties": {
          "travelMode": {
            "type": "string",
            "enum": [
              "walking",
              "cycling",
              "driving"
            ]
          },
          "days": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "note": {
                  "type": "string",
                  "description": "2～3句说明贴合用户偏好的推荐理由、当天主题和顺序考虑，通常80～160字，不编造耗时或剧情"
                },
                "spotReasons": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 6,
                  "description": "为当天每个pointId提供简短推荐理由，只用已检索信息",
                  "items": {
                    "type": "object",
                    "properties": {
                      "pointId": { "type": "string" },
                      "reason": { "type": "string", "maxLength": 240, "description": "1～2句说明为什么推荐该点；不编造剧情、集数、营业或交通信息" }
                    },
                    "required": ["pointId", "reason"]
                  }
                },
                "pointIds": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 6,
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "title",
                "note",
                "spotReasons",
                "pointIds"
              ]
            }
          }
        },
        "required": [
          "travelMode",
          "days"
        ]
      }
    }
  }
]
