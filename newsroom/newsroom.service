[Unit]
Description=0721ACGN Automatic Platform Newsroom
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=acgn
Group=acgn
WorkingDirectory=/opt/0721acgn/newsroom
ExecStart=/opt/0721acgn/newsroom/.venv/bin/python /opt/0721acgn/newsroom/worker.py run --config /opt/0721acgn/newsroom/config.json
Restart=on-failure
RestartSec=30
TimeoutStopSec=120
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/0721acgn/newsroom/data /opt/0721acgn/newsroom/browser-cache
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/0721acgn/newsroom/browser-cache
UMask=0027

[Install]
WantedBy=multi-user.target
